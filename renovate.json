{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Europe/Amsterdam",
  "labels": [
    "pr: dependency-update"
  ],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchFileNames": ["requirements_ha.txt"],
      "enabled": false
    },
    {
      "description": "Home Assistant 2026.11 and later block HACS from loading",
      "matchPackageNames": ["homeassistant"],
      "allowedVersions": "<2026.11"
    },
    {
      "description": "Devcontainer tags are <image major>-<Python version>, so only the Python version should move",
      "matchDepNames": ["mcr.microsoft.com/devcontainers/python"],
      "versioning": "regex:^(?<compatibility>\\d+)-(?<major>\\d+)\\.(?<minor>\\d+)$",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Bump Python everywhere in one PR",
      "matchDepNames": ["python", "mcr.microsoft.com/devcontainers/python"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "python"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["custom_components/hacs/validate/license.py"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+ = \"(?<currentDigest>[a-f0-9]+)\"\\s+# (?<currentValue>\\S+)"
      ]
    }
  ]
}
